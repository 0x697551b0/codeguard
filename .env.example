# CodeGuard 环境变量示例
# 用法：复制为 .env 后填入真实值，或在 shell 中直接 export。
# 注意： .env 已在 .gitignore 中，切勿把真实密钥提交到仓库。

# ---- 必填：LLM API Key ----
# DeepSeek 平台申请： https://platform.deepseek.com/api_keys
CODEGUARD_API_KEY=sk-替换成你自己的key

# ---- 可选：服务商与模型 ----
# DeepSeek（默认）
CODEGUARD_BASE_URL=https://api.deepseek.com
CODEGUARD_MODEL=deepseek-chat

# OpenAI 兼容写法示例（换服务商时改这三行即可，代码零改动）
# CODEGUARD_BASE_URL=https://api.openai.com/v1
# CODEGUARD_MODEL=gpt-4o-mini
# CODEGUARD_API_KEY=sk-xxxx

# 阿里云百炼（通义千问）OpenAI 兼容模式
# CODEGUARD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CODEGUARD_MODEL=qwen-plus

# ---- 可选：Agent 运行参数 ----
CODEGUARD_MAX_ITERATIONS=12
CODEGUARD_MAX_RETRIES=3
CODEGUARD_TIMEOUT=90
CODEGUARD_TEMPERATURE=0.2
CODEGUARD_MAX_FILE_BYTES=200000
CODEGUARD_LANG=zh
# 离线演示：为 1 时不访问网络，使用内置脚本化模型
CODEGUARD_MOCK=0
